{
  "manifest_version": 3,
  "name": "StateRAM Browser Bridge",
  "version": "0.2.0",
  "description": "Lets the StateRAM runtime reclaim cold Chromium tabs under real system memory pressure.",
  "key": "",
  "permissions": [
    "tabs",
    "alarms",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StateRAM Browser Bridge"
  }
}
